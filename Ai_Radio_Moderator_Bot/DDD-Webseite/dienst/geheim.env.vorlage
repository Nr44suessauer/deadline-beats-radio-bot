# Dienst ddd-radio - copy this file to geheim.env, fill in your values,
# then set the permissions to 600 (chmod 600 geheim.env).

AZ_URL=http://YOUR-STATION-HOST
AZ_KEY=YOUR-AZURACAST-API-KEY
AZ_STATION_ID=2
KATALOG_DIR=/daten
MELDUNG_SCHLUESSEL=YOUR-INBOX-KEY
LIVE_HOST=YOUR-STATION-HOST
LIVE_PORT=8015
LIVE_MOUNT=/
LIVE_USER=YOUR-BOT-STREAMER
LIVE_PASSWORD=YOUR-BOT-STREAMER-PASSWORD
LIVE_NAME=YOUR-BOT-DISPLAY-NAME
TTS_HOCHPASS_HZ=50
TTS_KOMPRESSOR_SCHWELLE_DB=-18
TTS_KOMPRESSOR_VERHAELTNIS=2.0
TTS_ZIEL_RMS_DB=-12.5
