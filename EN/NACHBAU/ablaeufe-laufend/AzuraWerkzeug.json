      {
        "parameters": {
          "method": "GET",
          "url": "={{ $('Configuration').first().json.konfig.sender.adresse + \"/api/openapi.yml\" }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-API-Key",
