        ],
        "notes": "Station response, summarised briefly.",
        "notesInFlow": true
      },
      {
        "parameters": {
          "jsCode": "\n// Nichts ausgefuehrt - nur die Meldung der Wache weitergeben.\nreturn [{ json: { ergebnis: String($json.ergebnis || 'Nichts zu tun.') } }];\n"
        },
