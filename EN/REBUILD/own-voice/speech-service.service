[Unit]
Description=YOUR-VOICE-TTS (edge-tts + RVC, CT 111)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Applio
Environment=PYTHONPATH=/opt/Applio
Environment=RVC_PTH=/opt/Applio/logs/<your-model>/<your-model>.pth
Environment=RVC_INDEX=/opt/Applio/logs/<your-model>/<your-model>.index
Environment=RVC_PITCH=4
# Mix of base voice and training material: 0.65
# (Operator choice 2026-09-23; 0.5 = clearer consonants, 0.75 = more deine-stimme sound color)
Environment=RVC_INDEX_RATE=0.65
Environment=BASIS_STIMME=de-DE-AmalaNeural
# Speech rate of the base: +40% is the operator-selected version
# (2026-09-23; the clarity version +20% was in use meantime)
Environment="BASIS_RATE=+40%"
Environment=HTTP_PORT=10205
# Manage CUDA cache in small pieces (fewer fragments,
# better compatibility with Ollama on the same card)
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ExecStart=/opt/Applio/.venv/bin/python /opt/Applio/sprechdienst/speech-service.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
