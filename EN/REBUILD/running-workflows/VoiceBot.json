      {
        "parameters": {
          "jsCode": "\n// Trefferlage bewerten: genau einer -> weiter, sonst Hinweis mit Liste.\nconst t = $json.treffer || [];\nconst serie = $('Fields').first().json.serie;\nif (!t.length) {\n  return [{ json: { gefunden: false,\n    nachricht: '\\u274c Nichts gefunden zu \\u00bb' + serie + '\\u00ab im Film-/Serienbestand.' } }];\n}\nif (t.length > 1) {\n  const liste = t.map(x => '\\u2022 ' + x.pfad + '  (' + x.videos + ' Videos)').join('\\n');\n  return [{ json: { gefunden: false,\n    nachricht: '\\u26a0\\ufe0f Mehrere Treffer zu \\u00bb' + serie + '\\u00ab \\u2014 bitte genauer angeben:\\n' + liste } }];\n}\nreturn [{ json: { gefunden: true, pfad: t[0].pfad, videos: t[0].videos } }];\n"
        },
