      {
        "parameters": {
          "jsCode": "\n// Formular- und Webhook-Eingaben vereinheitlichen (Feldnamen tolerant behandeln).\nconst roh = $input.first().json ?? {};\nconst b = Object.assign({}, roh, (roh.body && typeof roh.body === 'object') ? roh.body : {});\n// Achtung: Der Formular-Knoten (v2) liefert die Felder mit ihrer BESCHRIFTUNG als\n// Schluessel (\"Serie/Film (Name oder Pfad)\": \"Konosuba\"). Deshalb nach Stichworten\n// suchen - Stichwortreihenfolge hat Vorrang vor der Feldreihenfolge, damit z.B.\n// \"dataset\" nicht vom Wort \"Name\" in der Serien-Beschriftung ueberstimmt wird.\nconst hol = (teile, std) => {\n  for (const t of teile) {\n    for (const k of Object.keys(b)) {\n      const kk = String(k).toLowerCase();\n      if (kk.includes(t)) {\n        const w = b[k];\n        if (w !== undefined && w !== null && String(w).trim() !== '') return String(w).trim();\n      }\n    }\n  }\n  return std;\n};\nconst serie = hol(['serie', 'film', 'quelle', 'titel'], '');\nconst name = hol(['dataset', 'name fuer', 'name für', 'bezeichnung', 'projekt', 'name'], '');\nconst folgenZahl = parseInt(hol(['folgen', 'anzahl', 'limit'], '1'), 10);\nconst folgen = isNaN(folgenZahl) ? 1 : Math.max(0, folgenZahl);\nconst trennenRoh = hol(['trennen', 'sprecher'], 'ja').toLowerCase();\n// Webhook-Aufrufe muessen den Schluessel mitbringen (nur der API-Weg, das Formular nicht).\nif (roh.body) {\n  const s = (b['schluessel'] === undefined ? '' : String(b['schluessel'])).trim();\n  if (s !== 'JeQ5xcTTcJnzDW8HqbVmwxMW5NUh2Q') return [{ json: { fehler: 'schluessel' } }];\n}\nif (!serie || !name) {\n  return [{ json: { fehler: 'eingabe',\n    nachricht: 'Bitte Serie/Film UND einen Namen fuer das Dataset angeben.' } }];\n}\nreturn [{ json: { serie, name, folgen, trennen: ['ja', 'true', '1', 'yes', 'an'].includes(trennenRoh) } }];\n"
        },
