# Environment file of the radio-tts service (Template)
#
# How to use:
# cp geheim.env.vorlage /opt/radio-tts/geheim.env
# chmod 600 /opt/radio-tts/geheim.env
# Enter values below, then in the service directory:  docker compose up -d
#
# ATTENTION: This file contains secrets afterwards - do not copy into documentation
# or a repository. (That is why it is only a template here.)
#
# ---------------------------------------------------------------------------
# DJ-Hafen: here the moderation speaks live into the station (AzuraCast).
# Without these four values, POST /live responds with HTTP 400.
# ---------------------------------------------------------------------------
LIVE_HOST=192.168.178.33
LIVE_PORT=8005
LIVE_MOUNT=/
# Own streamer account of the bot (Original: deine-stimme, display name “YOUR-VOICE”)
LIVE_USER=enter-the-streamer-user-here
LIVE_PASSWORD=enter-the-streamer-password-here

# ---------------------------------------------------------------------------
# Volume of the moderation (all optional, here the configured values).
# Chain: High-pass -> Compress -> Level -> Limiter with lookahead.
# Measured with: -13.1 LUFS in the file, -11.8 LUFS on air.
# ---------------------------------------------------------------------------
TTS_ZIEL_RMS_DB=-11.5
LIVE_LAUTSTAERKE_DB=0
TTS_KOMPRESSOR_SCHWELLE_DB=-19
TTS_KOMPRESSOR_VERHAELTNIS=3.0
TTS_BEGRENZER_DB=-1.0
TTS_BEGRENZER_FREIGABE_MS=40
TTS_HOCHPASS_HZ=80
TTS_DEFAULT_VOICE=de_thorsten

# ---------------------------------------------------------------------------
# Research sources (optional, here the configured values).
# RECHERCHE_SEARX_URL points to your own search engine (LXC 108, SearXNG);
# without this value, the service queries DuckDuckGo and Bing directly (unreliable).
# RECHERCHE_WEBSEITEN supplements own sites without RSS feed (comma-separated).
# ---------------------------------------------------------------------------
RECHERCHE_SEARX_URL=http://192.168.178.26:8888
# RECHERCHE_WEBSEITEN=
# RECHERCHE_UEBERBLICK_MAX_ZEICHEN=6000
# RECHERCHE_THEMA_PRESSE=3
# RECHERCHE_THEMA_WEB=1
# RECHERCHE_THEMA_WIKI=1
# RECHERCHE_THEMA_FEED=1

# ---------------------------------------------------------------------------
# Hinweise
# * VOICE_DIR sets docker-compose.yml additionally itself (/voices).
# * The mailbox stores its key upon first write in
#   /data/news-key.txt (in the container). For a rebuild,
# Key itself to be generated and stored at the calling bot
# (see ../zugangsdaten.md).
# * The catalog index is created via POST /catalog/refresh  (~47 s).
