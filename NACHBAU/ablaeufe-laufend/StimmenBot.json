      {
        "parameters": {
          "jsCode": "\n// Zustand des Auftrags in eine Nachricht giessen; Rundenzaehler hochsetzen.\nconst d = $getWorkflowStaticData('global');\nd.zaehler = (d.zaehler || 0) + 1;\nconst j = $json || {};\nconst f = j.fortschritt || {};\nconst cluster = Object.entries(f.cluster || {}).map(([k, v]) => k + '=' + v.segmente).join(', ');\nconst stand = (f.segmente !== undefined ? f.segmente + ' Segmente / ' + (f.minuten || 0) + ' Min' : '') +\n              (cluster ? ' \\u00b7 Cluster: ' + cluster : '');\nconst st = j.status || 'unbekannt';\nlet nachricht = '';\nif (st === 'fertig') {\n  const pfad = (j.ergebnis || {}).pfad || '';\n  nachricht = '\\u2705 Fertig: Dataset \\u00bb' + (j.name || '') + '\\u00ab\\n' + stand +\n              (pfad ? '\\nPfad: ' + pfad : '') +\n              '\\n\\nNaechster Schritt: Sprecher-Cluster anhoeren (werkzeuge/cluster-proben.sh) und den Charakter waehlen.';\n} else if (st === 'fehler' || st === 'abgebrochen') {\n  nachricht = (st === 'abgebrochen' ? '\\u26d4 Abgebrochen: ' : '\\u274c Fehler: ') + (j.meldung || '') +\n              '\\nLog: ' + (j.log || '');\n} else {\n  nachricht = '\\u23f3 laeuft: Schritt ' + (j.schritt || '?') + (stand ? ' \\u2014 ' + stand : '');\n}\nreturn [{ json: { status: st, zaehler: d.zaehler, nachricht } }];\n"
        },
