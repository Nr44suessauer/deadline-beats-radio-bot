      {
        "parameters": {
          "jsCode": "\n// Antwort des Dienstes auf /extrahieren auswerten und den Rundenzaehler zuruecksetzen.\nconst a = $json || {};\nif (a.gestartet) {\n  const d = $getWorkflowStaticData('global');\n  d.zaehler = 0;\n  return [{ json: { laeuft: true, nachricht: '' } }];\n}\nlet text = '';\nif (a.error) text = a.error.message || a.error.description || JSON.stringify(a.error);\nelse if (typeof a.detail === 'string') text = a.detail;\nelse if (a.detail) text = JSON.stringify(a.detail);\nelse if (a.message) text = a.message;\nelse text = JSON.stringify(a).slice(0, 300);\nreturn [{ json: { laeuft: false, nachricht: '\\u26a0\\ufe0f Auftrag nicht gestartet: ' + text } }];\n"
        },
