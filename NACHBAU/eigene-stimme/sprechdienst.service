[Unit]
Description=DEINE-STIMME-TTS (edge-tts + RVC, CT 111)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Applio
Environment=PYTHONPATH=/opt/Applio
Environment=RVC_PTH=/opt/Applio/logs/<dein-modell>/<dein-modell>.pth
Environment=RVC_INDEX=/opt/Applio/logs/<dein-modell>/<dein-modell>.index
Environment=RVC_PITCH=4
# Mischung aus Basisstimme und Trainingsmaterial: 0,65
# (Betreiber-Wahl 2026-09-23; 0,5 = klarere Konsonanten, 0,75 = mehr DEINE-STIMME-Klangfarbe)
Environment=RVC_INDEX_RATE=0.65
Environment=BASIS_STIMME=de-DE-AmalaNeural
# Sprechtempo der Basis: +40 % ist die vom Betreiber gewaehlte Fassung
# (2026-09-23; die Klarheitsfassung +20 % war zwischenzeitlich im Einsatz)
Environment="BASIS_RATE=+40%"
Environment=HTTP_PORT=10205
# CUDA-Zwischenspeicher in kleinen Stuecken verwalten (weniger Bruchstuecke,
# bessere Vertraeglichkeit mit Ollama auf derselben Karte)
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ExecStart=/opt/Applio/.venv/bin/python /opt/Applio/sprechdienst/sprechdienst.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
