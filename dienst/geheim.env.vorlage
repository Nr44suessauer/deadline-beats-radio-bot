# Umgebungsdatei des Dienstes radio-tts  (Vorlage)
#
# So verwenden:
#   cp geheim.env.vorlage /opt/radio-tts/geheim.env
#   chmod 600 /opt/radio-tts/geheim.env
#   Werte unten eintragen, dann im Dienstverzeichnis:  docker compose up -d
#
# ACHTUNG: Diese Datei enthaelt danach Geheimnisse - nicht in eine Dokumentation
# oder ein Repository kopieren. (Deshalb ist sie hier nur eine Vorlage.)
#
# ---------------------------------------------------------------------------
# DJ-Hafen: hier spricht die Moderation live in den Sender (AzuraCast).
# Ohne diese vier Werte antwortet POST /live mit HTTP 400.
# ---------------------------------------------------------------------------
LIVE_HOST=192.168.178.33
LIVE_PORT=8005
LIVE_MOUNT=/
# Eigenes Streamer-Konto des Bots (Original: deine-stimme, Anzeigename "DEINE-STIMME")
LIVE_USER=hier-den-streamer-benutzer-eintragen
LIVE_PASSWORD=hier-das-streamer-passwort-eintragen

# ---------------------------------------------------------------------------
# Lautstaerke der Moderation (alle optional, hier die eingestellten Werte).
# Kette: Hochpass -> Verdichten -> Pegel -> Begrenzer mit Vorausschau.
# Gemessen damit: -13,1 LUFS in der Datei, -11,8 LUFS auf Sendung.
# ---------------------------------------------------------------------------
TTS_ZIEL_RMS_DB=-11.5
LIVE_LAUTSTAERKE_DB=0
TTS_KOMPRESSOR_SCHWELLE_DB=-19
TTS_KOMPRESSOR_VERHAELTNIS=3.0
TTS_BEGRENZER_DB=-1.0
TTS_BEGRENZER_FREIGABE_MS=40
TTS_HOCHPASS_HZ=80
TTS_DEFAULT_VOICE=de_thorsten

# ---------------------------------------------------------------------------
# Recherche-Quellen (optional, hier die eingestellten Werte).
# RECHERCHE_SEARX_URL zeigt auf die eigene Suchmaschine (LXC 108, SearXNG);
# ohne den Wert fragt der Dienst DuckDuckGo und Bing direkt (unzuverlaessig).
# RECHERCHE_WEBSEITEN ergaenzt eigene Seiten ohne RSS-Feed (kommagetrennt).
# ---------------------------------------------------------------------------
RECHERCHE_SEARX_URL=http://192.168.178.26:8888
# RECHERCHE_WEBSEITEN=
# RECHERCHE_UEBERBLICK_MAX_ZEICHEN=6000
# RECHERCHE_THEMA_PRESSE=3
# RECHERCHE_THEMA_WEB=1
# RECHERCHE_THEMA_WIKI=1
# RECHERCHE_THEMA_FEED=1

# ---------------------------------------------------------------------------
# Hinweise
# * VOICE_DIR setzt docker-compose.yml zusaetzlich selbst (/voices).
# * Das Postfach legt seinen Schluessel beim ersten Schreiben in
#   /daten/meldung-schluessel.txt an (im Container). Fuer einen Nachbau den
#   Schluessel selbst erzeugen und beim aufrufenden Bot hinterlegen
#   (siehe ../zugangsdaten.md).
# * Der Katalogindex entsteht ueber  POST /katalog/aktualisieren  (~47 s).
